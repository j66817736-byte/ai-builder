{
  "name": "ai-builder",
  "version": "1.0.0",
  "description": "CLI local-first para analizar proyectos, generar starters y documentación; generación Gemini opcional y explícita",
  "type": "module",
  "bin": {
    "ai-builder": "./bin/ai-builder.js"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build && npm run typecheck && npm run lint && npm test",
    "prepare": "npm run build"
  },
  "keywords": [
    "ai",
    "builder",
    "cli",
    "project-analysis",
    "security",
    "privacy",
    "multiplatform",
    "typescript",
    "documentation",
    "admin-panel",
    "local-first",
    "developer-tools"
  ],
  "author": "j66817736-byte",
  "license": "MIT",
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/j66817736-byte/ai-builder",
    "directory": "./"
  },
  "bugs": {
    "url": "https://github.com/j66817736-byte/ai-builder/issues"
  },
  "homepage": "https://github.com/j66817736-byte/ai-builder#readme",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "chalk": "^5.1.2",
    "fs-extra": "^11.1.0",
    "inquirer": "^9.0.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.0",
    "@types/inquirer": "^9.0.0",
    "@types/node": "^22.13.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5",
    "vitest": "^5.0.3",
    "vite": "^6.4.3",
    "prettier": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0"
  }
}
